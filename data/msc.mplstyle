font.family : Arial
#font.weight : bold
font.size : 8

#text.usetex : true

xtick.major.width : 1
xtick.direction : in
xtick.top : True
ytick.major.width : 1
ytick.direction : in
ytick.right : True

axes.grid : True
grid.linestyle : (0, (5, 5))
grid.alpha : 0.5

figure.figsize : 8, 4

axes.prop_cycle : cycler(linestyle=["-", "--", "-.", ":"])
axes.linewidth : 1
lines.color : k
